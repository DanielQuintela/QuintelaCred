
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String      @id @default(uuid())
  email                  String      @unique
  password               String
  name                   String

  role                   UserRole
  status                 UserStatus  @default(ACTIVE)
  first_login            Boolean     @default(true)

  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
}

model Tax {
  id                    String    @id @default(uuid())
  installments_number   Int
  value                 Decimal   @db.Decimal(10, 5)

  card_flag             CardFlag
  type                  TaxType
  bank_name             String?

  description           String?

  location_id           String?
  location              Location?  @relation(fields: [location_id], references: [id], onDelete: Cascade)

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
}

model Log {
  id                    String    @id @default(uuid())

  table_name            String
  record_id             String

  user_id               String?

  action                LogAction

  old_values            Json?
  new_values            Json?

  timestamp             DateTime  @default(now())

  @@index([table_name])
  @@index([record_id])
  @@index([user_id])
  @@index([timestamp])
}

model Simulation {
  id                    String    @id @default(uuid())
  
  user_id               String?

  location_id           String?
  location              Location?  @relation(fields: [location_id], references: [id], onDelete: SetNull)

  amount                Decimal   @db.Decimal(10, 2)

  card_flag             CardFlag
  type                  TaxType
  bank_name             String?

  installments_number   Int

  status                SimulationStatus @default(SIMULATED)
  tax_percentage        Decimal   @db.Decimal(10, 5)

  installment_amount    Decimal   @db.Decimal(10, 2)
  received_amount       Decimal   @db.Decimal(10, 2)
  card_amount           Decimal   @db.Decimal(10, 2)

  created_at            DateTime @default(now())

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([card_flag])
  @@index([type])
  @@index([status, created_at])
}

model Location {
  id          String        @id @default(uuid())
  name        String       
  city        String?      
  state       String?      
  is_active   Boolean       @default(true)

  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  taxes       Tax[]
  simulations Simulation[]

  @@unique([name, city]) // Evita duplicar o mesmo bairro na mesma cidade
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CardFlag {
  MASTER
  VISA
  ELO
  AMEX
  DINERS
  HIPERCARD
  VISAMASTER
  ELODEMAISBANDEIRAS
  OUTROS
}

enum TaxType {
  LIBERADO
  LIMITE
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  UPDATE_STATUS
}

enum SimulationStatus {
  SIMULATED
  CONVERTED
  CANCELLED
}