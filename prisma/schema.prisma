
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      UserRole
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Tax {
  id                 String    @id @default(uuid())
  installmentsNumber Int
  value              Decimal   @db.Decimal(10, 5)

  cardFlag           CardFlag
  type               TaxType
  bankName           String?

  description        String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CardFlag {
  MASTER
  VISA
  ELO
  AMEX
  DINERS
  HIPERCARD
  OUTROS
}

enum TaxType {
  LIBERADO
  LIMITE
}