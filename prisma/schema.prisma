
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  password              String
  name                  String

  role                  UserRole
  status                UserStatus  @default(ACTIVE)
  
  create_at DateTime    @default(now())
  update_at DateTime    @updatedAt
}

model Tax {
  id                    String    @id @default(uuid())
  installments_number   Int
  value                 Decimal   @db.Decimal(10, 5)

  card_flag             CardFlag
  type                  TaxType
  bank_name             String?

  description           String?

  create_at             DateTime  @default(now())
  update_at             DateTime  @updatedAt
}

model Log {
  id                    String    @id @default(uuid())

  table_name            String
  record_id             String

  user_id               String?

  action                LogAction

  old_values            Json?
  new_values            Json?

  timestamp             DateTime  @default(now())

  @@index([table_name])
  @@index([record_id])
  @@index([user_id])
  @@index([timestamp])
}

model Simulation {
  id                    String    @id @default(uuid())

  user_id               String?

  amount                Decimal   @db.Decimal(10, 2)

  card_flag             CardFlag
  type                  TaxType
  bank_name             String?

  installments_number   Int

  status                SimulationStatus @default(SIMULATED)
  tax_percentage        Decimal   @db.Decimal(10, 5)

  receivedAmount        Decimal   @db.Decimal(10, 2)
  installment_amount    Decimal   @db.Decimal(10, 2)
  received_amount       Decimal   @db.Decimal(10, 2)
  card_amount           Decimal   @db.Decimal(10, 2)

  created_at            DateTime @default(now())

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([card_flag])
  @@index([type])
  @@index([status, created_at])
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CardFlag {
  MASTER
  VISA
  ELO
  AMEX
  DINERS
  HIPERCARD
  OUTROS
}

enum TaxType {
  LIBERADO
  LIMITE
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  UPDATE_STATUS
}

enum SimulationStatus {
  SIMULATED
  CONVERTED
  CANCELLED
}